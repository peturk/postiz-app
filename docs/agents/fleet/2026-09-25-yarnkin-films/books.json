 "sb_1782458330480_f89riq": {
  "title_is": "Geturðu fundið vettlinginn?",
  "title": "Can You Find the Mitten?",
  "pages": [
   {
    "n": 1,
    "is": "Sjáðu básinn á Maker Fair! Geturðu fundið rjómalitaða pappírsvettlinginn?",
    "en": "Look at the Maker Fair booth! Can you find the cream paper mitten?",
    "layout": "full-bleed"
   },
   {
    "n": 2,
    "is": "Fræið er mjög lítið. Geturðu komið auga á litla, brúna fræið í moldinni? Hvað skyldi vaxa upp af því?",
    "en": "The seed is very small. Can you spot the tiny brown seed in the soil? What will it grow into?",
    "layout": "image-top-text-bottom"
   },
   {
    "n": 3,
    "is": "Árni vill smíða vaxtarvél. Geturðu valið hringlaga, bláa tannhjólið sem passar í raufina?",
    "en": "Ari wants to build a growth machine. Can you choose the round blue gear that fits the slot?",
    "layout": "text-left-image-right"
   },
   {
    "n": 4,
    "is": "Plöntur þurfa vatn. Geturðu fylgt slóð vatnsdropanna niður í moldina?",
    "en": "Plants need water. Can you trace the line of water drops to the soil?",
    "layout": "image-left-text-right"
   },
   {
    "n": 5,
    "is": "Sjáðu! Fræið varð að laufgrænni plöntu. Geturðu talið appelsínugulu gulræturnar? Flettu við til að sjá þær skína!",
    "en": "Look! The seed grew into a leafy green plant. Can you count the orange carrots? Turn the page to see them shine!",
    "layout": "text-left-image-right"
   },
   {
    "n": 6,
    "is": "Hver biti á sér sögu! Geturðu parað bleiku gulrótaskálina við vélmennið?",
    "en": "Every bite has a story! Can you match the pink bowl of carrots to the robot?",
    "layout": "full-bleed"
   }
  ],
